# Maks antall rader som hentes når spørringen ikke selv har LIMIT (default 50000)
SPARQL_ROW_CAP=50000

# Timeout mot endepunktet i millisekunder (default 125000 – litt over endepunktets 2 min)
SPARQL_TIMEOUT_MS=125000

# AI-hjelp i editoren (idé 3, se Docs/ideer-ai-stotte.md): #+ regex:/filter:-kommentarer.
# Uten denne svarer /api/ai-assist med 501, og dropdownen viser feilmeldingen som forslag.
ANTHROPIC_API_KEY=
